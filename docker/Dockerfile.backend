FROM node:22-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM golang:1.25-alpine AS backend-builder

WORKDIR /src
COPY backend/go.mod backend/go.sum* ./
RUN go mod download

COPY backend/ ./
ARG VERSION=1.1.0
ARG GIT_COMMIT=dev
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT} -X main.BuildTime=${BUILD_TIME}" \
    -o /out/pionex-bot ./cmd/pionex-bot \
    && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/pionex-admin ./cmd/pionex-admin \
    && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X main.Version=${VERSION}" -o /out/pionex-mcp ./cmd/pionex-mcp

FROM alpine:3.22
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=backend-builder /out/pionex-bot /app/pionex-bot
COPY --from=backend-builder /out/pionex-admin /app/pionex-admin
COPY --from=backend-builder /out/pionex-mcp /app/pionex-mcp
COPY --from=frontend-builder /frontend/dist /app/frontend
COPY migrations /app/migrations

RUN addgroup -S pionex && adduser -S -G pionex pionex \
    && chown -R pionex:pionex /app
USER pionex

EXPOSE 8080
CMD ["/app/pionex-bot"]
