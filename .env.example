# Copy to .env and fill in a private value before `docker compose up`.
# .env is gitignored; never commit real secrets.
#
# PostgreSQL password for the `pionex` bootstrap user. Used by the postgres
# image at FIRST volume initialization and by the backend/quant-worker
# DATABASE_URL on every start.
#
# Rotating an existing deployment (the old value was committed to git and
# must be treated as compromised):
#   1. docker exec -it pionex_postgres psql -U pionex -d pionex_bot \
#        -c "ALTER USER pionex WITH PASSWORD '<new-password>';"
#   2. put the same value in .env
#   3. docker compose up -d
POSTGRES_PASSWORD=change-me-to-a-long-random-string
